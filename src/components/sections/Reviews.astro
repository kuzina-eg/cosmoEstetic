---
import SectionHeader from '@components/blocks/SectionHeader.astro';
import ReviewCard from '@components/blocks/ReviewCard.astro';
import Icon from '@components/modules/Icon.astro';

interface Props {
    title?: string;
    subtitle?: string;
    sm?: boolean; // компактные вертикальные отступы (внутренние страницы)
}
const {
    title = 'Отзывы наших клиентов',
    subtitle,
    sm = false,
} = Astro.props;

const reviews = [
    {
        image: 'img/reviews/01',
        rating: 5,
        author: 'Елена Семёнова',
        text: 'Это единственная линия средств по уходу за кожей, которая действительно преобразила мою кожу. Чистая роскошь в каждой капле.',
    },
    {
        image: 'img/reviews/02',
        rating: 4,
        author: 'Марина Ковалёва',
        // намеренно длинный отзыв — на нём проверяется «показать весь текст»
        text: 'Покупала бальзам без особых ожиданий: до этого перепробовала, наверное, десяток разных — от аптечных до люксовых, и почти все вели себя одинаково. Первые двадцать минут ощущение комфорта, а дальше губы снова стягивает, и рука сама тянется нанести ещё раз. К концу зимы это превращалось в замкнутый круг: чем чаще мажешь, тем хуже становится без бальзама. Здесь всё оказалось иначе, и я не сразу это заметила. Просто в какой-то момент поймала себя на том, что не проверяю сумку на наличие стика перед выходом. Текстура плотная, но не липкая, не оставляет плёнки и не скатывается под помадой — это отдельная радость, потому что раньше приходилось выбирать между уходом и макияжем. Через три недели ушли трещинки в уголках рта, которые не заживали с ноября. Отдельно отмечу запах: он почти незаметный и исчезает за минуту, никакой отдушки, от которой к вечеру болит голова. Заказывала дважды, доставка оба раза пришла раньше срока, упаковка аккуратная, внутри лежала открытка от руки — мелочь, а приятно.',
    },
    {
        image: 'img/reviews/03',
        rating: 5,
        author: 'Ольга Дмитриева',
        text: 'Наношу перед выходом на мороз — впервые за много лет губы не трескаются. Расход экономный, одного стика хватило на всю зиму.',
    },
    {
        image: 'img/reviews/04',
        rating: 5,
        author: 'Анна Лебедева',
        text: 'Брала в подарок сестре, в итоге заказала и себе. Сдержанная упаковка, приятно держать в руках, и главное — работает.',
    },
    {
        image: 'img/reviews/01',
        rating: 5,
        author: 'Ирина Волкова',
        // второй длинный — чтобы было видно, что разворот у каждой карточки свой
        text: 'Долго не решалась заказать: смущала цена, тем более что бальзам для губ кажется вещью, на которой легко сэкономить. В итоге считала так: обычный стик я покупала раз в три недели, потому что он либо заканчивался, либо переставал помогать. Этот стоит примерно как четыре таких, но живёт с ноября и израсходован едва наполовину. Сначала показалось, что текстура плотнее привычной, и первые пару дней я наносила слишком много. Потом приноровилась: достаточно одного лёгкого движения, и его хватает часов на шесть, даже если пьёшь кофе и разговариваешь весь день. Отдельно скажу про состав — я аллергик, и для меня важно, что здесь нет отдушек и привычного набора раздражителей. Реакции не было ни разу. Единственное, чего не хватает, — варианта с лёгким оттенком, бесцветный иногда хочется чем-то дополнить.',
    },
    {
        image: 'img/reviews/02',
        rating: 5,
        author: 'Светлана Титова',
        text: 'Заказ пришёл за два дня. Бальзам мягкий, ложится ровно, под помаду тоже подходит.',
    },
];
---
<section class:list={['section', sm && 'section--sm', 'reviews']}>
    <div class="container">
        <SectionHeader title={title} subtitle={subtitle} />
        <div class="reviews__carousel">
            <div class="swiper reviews__slider js-reviews">
                <div class="swiper-wrapper">
                    {reviews.map((r) => <ReviewCard {...r} />)}
                </div>
                <button class="reviews__arrow reviews__arrow--prev slider-arrow swiper-button-prev js-reviews-prev" type="button" aria-label="Назад">
                    <Icon name="arrow-left" />
                </button>
                <button class="reviews__arrow reviews__arrow--next slider-arrow swiper-button-next js-reviews-next" type="button" aria-label="Вперёд">
                    <Icon name="arrow-right" />
                </button>
                <div class="reviews__pagination swiper-pagination js-reviews-pagination"></div>
            </div>
        </div>
    </div>
</section>
