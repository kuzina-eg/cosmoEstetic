---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/blocks/Breadcrumbs.astro';
import Badge from '@components/blocks/Badge.astro';
import Button from '@components/modules/Button.astro';
import CtaBanner from '@components/sections/CtaBanner.astro';
import formatDate from '@utils/formatDate';
import typograf from '@utils/typograf';

const order = {
    number: '8310737',
    date: '2026-09-03',
    status: 'Новый',
    payStatus: 'Ожидает оплаты',
};

const customer = [
    { label: 'Покупатель', value: 'Виталий Викторович' },
    { label: 'Контактный телефон', value: '+7 960 252-52-52', href: 'tel:+79602525252' },
    { label: 'Контактный e-mail', value: 'stepleer@mail.ru', href: 'mailto:stepleer@mail.ru' },
];

const pvz = [
    { label: 'Адрес пункта', value: '127495, Россия, Москва, Дмитровское ш., 165 ЕК6' },
    { label: 'Режим работы', value: 'Пн–Пт 10:00–21:00, Сб–Вс 10:00–20:00' },
    { label: 'Телефон', value: '+7 925 824-38-71', href: 'tel:+79258243871' },
];

const items = [
    { image: 'img/products/01', title: 'Essential Lip Balm', option: 'Бесцветный, 10 мл', qty: 2, sum: '6 000 ₽' },
    { image: 'img/products/02', title: 'Lip Perfection Chocolate', option: 'Молочный шоколад, 10 мл', qty: 1, sum: '3 000 ₽' },
];

const totals = [
    { label: 'Товары, 3 шт.', value: '9 000 ₽' },
    { label: 'Доставка', value: '1 000 ₽' },
    { label: 'Итого', value: '10 000 ₽', isTotal: true },
];
---
<Layout title="Ваш заказ принят">
  <div class="container page-top">
    <Breadcrumbs items={[
      { text: 'Главная', url: '/' },
      { text: 'Корзина', url: 'cart.html' },
      { text: 'Заказ оформлен' },
    ]} />

    <div class="order">
      <header class="order__header">
        <h1 class="page-title order__title" set:html={typograf('Ваш заказ принят')} />
        <p class="order__lead" set:html={typograf(`Заказ № ${order.number} от ${formatDate(order.date)}`)} />
      </header>

      <div class="order__statusbar">
        <div class="order__status">
          <span class="order__label">Статус заказа</span>
          <Badge text={order.status} />
        </div>
        <div class="order__status">
          <span class="order__label">Статус оплаты</span>
          <Badge text={order.payStatus} variant="wait" />
        </div>
        <Button type="link" href="#" icon="wallet" class="order__pay">Оплатить</Button>
      </div>

      <div class="order__grid">
        <section class="order__block">
          <h2 class="order__subtitle" set:html={typograf('Покупатель')} />
          <dl class="order__fields">
            {customer.map((f) => (
              <div class="order__field">
                <dt class="order__label" set:html={typograf(f.label)} />
                <dd class="order__value">
                  {f.href
                    ? <a class="order__link" href={f.href}>{f.value}</a>
                    : <Fragment set:html={typograf(f.value)} />}
                </dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="order__block">
          <h2 class="order__subtitle" set:html={typograf('Доставка')} />
          <dl class="order__fields">
            <div class="order__field">
              <dt class="order__label" set:html={typograf('Способ доставки')} />
              <dd class="order__value" set:html={typograf('Пункт выдачи СДЭК')} />
            </div>
            <div class="order__field">
              <dt class="order__label" set:html={typograf('Отслеживание')} />
              <dd class="order__value">
                <a class="order__link" href="#" set:html={typograf(`Отправление СДЭК № ${order.number}`)} />
              </dd>
            </div>
          </dl>

          <div class="order__pvz">
            <div class="order__pvz-name" set:html={typograf('Пункт самовывоза MSK2407 — Москва, Дмитровское ш.')} />
            <dl class="order__fields order__fields--tight">
              {pvz.map((f) => (
                <div class="order__field">
                  <dt class="order__label" set:html={typograf(f.label)} />
                  <dd class="order__value">
                    {f.href
                      ? <a class="order__link" href={f.href}>{f.value}</a>
                      : <Fragment set:html={typograf(f.value)} />}
                  </dd>
                </div>
              ))}
            </dl>
            <p class="order__pvz-note" set:html={typograf('CDEK, остановка «Заболотье», вход с внутренней стороны двора.')} />
          </div>
        </section>
      </div>

      <section class="order__block">
        <h2 class="order__subtitle" set:html={typograf('Состав заказа')} />

        <ul class="order__items">
          {items.map((it) => (
            <li class="item-order">
              <img
                class="item-order__image lazy"
                width="140"
                height="140"
                data-src={`${it.image}@1x.webp`}
                data-srcset={`${it.image}@2x.webp 2x`}
                alt=""
              />
              <div class="item-order__body">
                <div class="item-order__title" set:html={typograf(it.title)} />
                <div class="item-order__option" set:html={typograf(it.option)} />
              </div>
              <div class="item-order__qty" set:html={typograf(`${it.qty} шт.`)} />
              <div class="item-order__sum" set:html={typograf(it.sum)} />
            </li>
          ))}
        </ul>

        <dl class="order__totals">
          {totals.map((t) => (
            <div class:list={['order__total', t.isTotal && 'order__total--main']}>
              <dt class="order__total-label" set:html={typograf(t.label)} />
              <span class="order__total-line"></span>
              <dd class="order__total-value" set:html={typograf(t.value)} />
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>

  <CtaBanner />
</Layout>
